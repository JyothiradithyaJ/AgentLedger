# Server configuration
NODE_ENV=development
PORT=3000
HOST=localhost

# PayPal Sandbox credentials (https://developer.paypal.com)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_WEBHOOK_ID=

# Gemini API configuration (Google AI Studio free tier)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Ollama local configuration (optional)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# LLM provider selection: gemini | ollama | mock
LLM_PROVIDER=gemini

# Product catalog provider: mock | dummyjson
CATALOG_PROVIDER=dummyjson

# PayPal integration mode: sandbox | mock
PAYPAL_MODE=sandbox

# Dispute handling mode: simulated | sandbox
DISPUTE_MODE=simulated

# Demo mode toggle: true | false
DEMO_MODE=

# Optional allowed frontend origin for CORS (e.g. http://localhost:5173)
FRONTEND_URL=

# Agent toolkit integration flag
USE_AGENT_TOOLKIT=false

# SQLite database file path
DATABASE_PATH=data/agentledger.db

# Ed25519 cryptographic keys directory
KEYS_DIR=data/keys
